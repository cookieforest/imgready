<!-- FULLSCREEN COMPARE MODAL -->
<div class="fs-modal" id="fsModal" role="dialog" aria-modal="true" aria-label="Compare original and result">
  <div class="fs-inner" id="fsInner" oncontextmenu="return false">
    <div class="fs-zoom-wrap" id="fsZoom">
      <img class="fs-before" id="fsBefore" alt="original">
    </div>
    <div class="fs-clip" id="fsClip">
      <div class="fs-zoom-after" id="fsZoomAfter">
        <img class="fs-after" id="fsAfter" alt="optimized">
      </div>
    </div>
    <div class="fs-divider" id="fsDiv"></div>
    <div class="fs-handle" id="fsHdl"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2.5" stroke-linecap="round"><path d="M8 4l-4 8 4 8M16 4l4 8-4 8"/></svg></div>
    <div class="fs-lbl l" id="fsLblBefore">ORIGINAL</div>
    <div class="fs-lbl r" id="fsLblAfter">OPTIMIZED</div>
    <!-- Visible only while the modal is in preview-only mode (solo drop
         hasn't finished encoding yet). Small files get a pulsing dot;
         files >5 MB get a thin progress bar driven by a time estimate
         based on input size + target format, capped at 95% until the
         actual result lands. The bar gives multi-second AVIF encodes a
         visual heartbeat instead of a stalled-looking pause. -->
    <div class="fs-encoding-pulse" id="fsEncodingPulse" aria-live="polite">
      <span class="fs-pulse-dot"></span>
      <span class="fs-pulse-text" id="fsPulseText">Encoding…</span>
      <span class="fs-pulse-bar" id="fsPulseBar"><span class="fs-pulse-bar-fill" id="fsPulseBarFill"></span></span>
    </div>
    <div class="fs-zoom-level" id="fsZoomLevel">100%</div>
    <div class="fs-editor" id="fsEditor">
      <div class="fs-editor-inner">
        <div class="fe-fmt" id="feFmt"></div>
        <div class="fe-q">
          <input type="range" id="feQSlider" min="10" max="100" value="82">
          <span class="fe-q-val" id="feQVal">82</span>
        </div>
        <div class="fe-spinner" id="feSpinner"></div>
        <span class="fe-size" id="feSize"></span>
        <!-- Apply button removed — the live slider auto-commits each settle.
             What you see in the modal is what's saved on the card. -->
        <button class="fe-dl" id="feDlBtn" onclick="feLiveDl()">Download</button>
      </div>
    </div>
