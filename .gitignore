# Local install
node_modules/
*.log
.DS_Store
.env
.env.local

# Build output: the *.map files only. dist/ is committed as a fallback
# for Cloudflare's deploy until we confirm wrangler [build].command runs
# on every push. Once verified, dist/ moves back into .gitignore and
# Cloudflare regenerates it per push.
dist/*.map

# Python bytecode from tools/
__pycache__/
*.pyc

# Page generator working files. Both are regenerated by
#   python scripts/extract_pages.py
# build/parts/ IS committed: it is the captured canonical tool block that
# build_pages.py renders into every page.
build/out/
build/pages.json

# build/fixtures holds the hand-built EXIF test JPEG. Kept in the repo
# (it is 335 bytes and the parser is meaningless without it) but build/
# is excluded from the deploy so it never ships.
