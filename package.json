{
  "name": "imgready",
  "version": "1.0.0",
  "private": true,
  "description": "Free in-browser image compressor, converter and resizer.",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "dev": "node build.mjs --watch",
    "check": "node --check imgready-worker.js && node --check sw.js",
    "verify": "npm run check && npm run build && node --check dist/app.js"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
