# imgready redirects
#
# IMPORTANT: every rule needs BOTH the slash-less and trailing-slash form.
#
# Cloudflare's automatic trailing-slash normalisation only fires for paths
# that correspond to a real asset directory — it sees dist/compress/ and so
# sends /compress -> /compress/. The paths below are shorthands with no
# directory behind them, so nothing normalises them, and a rule written only
# as "/heic/" never matches a request for "/heic". That was returning a hard
# 404 for the slash-less form of all seven rules — which is the form people
# actually type and link. Google had already found three of them.
#
# First match wins, so keep the slash-less line next to its partner.

# PNG to JPEG spelling variant
/png-to-jpeg    /png-to-jpg/    301
/png-to-jpeg/   /png-to-jpg/    301

# RAW to JPG — imgready doesn't support RAW files in-browser, send to TIFF
# converter (closest professional format)
/raw-to-jpg     /tiff-to-jpg/   301
/raw-to-jpg/    /tiff-to-jpg/   301

# Common shorthand for the compressor
/compress-image         /compress/      301
/compress-image/        /compress/      301
/image-compressor       /compress/      301
/image-compressor/      /compress/      301

# HEIC shorthands
/convert-heic           /heic-to-jpg/   301
/convert-heic/          /heic-to-jpg/   301
/heic                   /heic-to-jpg/   301
/heic/                  /heic-to-jpg/   301
/heic-converter         /heic-to-jpg/   301
/heic-converter/        /heic-to-jpg/   301

# WebP shorthands
/webp                   /webp-converter/    301
/webp/                  /webp-converter/    301

# AVIF shorthand — mirrors the WebP pair above
/avif                   /avif-converter/    301
/avif/                  /avif-converter/    301

# /favicon-generator/ used to redirect to /png-to-ico/, from before the real
# favicon generator page existed. That rule silently hid the new page from
# every visitor and from Google. Check 26 in tests/site-checks.mjs now fails
# if any sitemapped page is redirected away.

# Generic "I want a converter" intent lands on the tool index
/image-converter        /tools/         301
/image-converter/       /tools/         301
/convert                /tools/         301
/convert/               /tools/         301

# Legacy .html URLs, one hop.
#
# Without an explicit rule the edge strips the extension first
# (/privacy.html -> /privacy) and only then normalises the slash
# (/privacy -> /privacy/). Two hops. Google leaks signal through a
# chain and reports it separately, and Search Console has both
# /privacy.html and /about.html sitting in 'Page with redirect'.
# These send them straight to the canonical URL in one hop.

/privacy.html              /privacy/       301
/about.html                /about/         301
/terms.html                /terms/         301
/support.html              /support/       301
/developers.html           /developers/    301
/compress.html             /compress/      301
/resize.html               /resize/        301
/tools.html                /tools/         301
/why.html                  /why/           301
/heic-to-jpg.html          /heic-to-jpg/   301
/webp-converter.html       /webp-converter/ 301
/avif-converter.html       /avif-converter/ 301
/png-to-jpg.html           /png-to-jpg/    301
/jpg-to-png.html           /jpg-to-png/    301
/webp-to-jpg.html          /webp-to-jpg/   301
/webp-vs-png-vs-jpg.html   /webp-vs-png-vs-jpg/ 301
/index.html                /              301

