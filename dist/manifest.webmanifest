{
  "name": "imgready \u2014 image tool that never uploads",
  "short_name": "imgready",
  "description": "Compress, convert and resize images entirely in your browser. HEIC, TIFF, WebP, AVIF, PNG, JPG. Your photo stays on your screen.",
  "id": "/",
  "start_url": "/?utm_source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f9f0e4",
  "theme_color": "#b84d1d",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icon-192-maskable.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512-maskable.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/favicon-large.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    }
  ],
  "categories": [
    "productivity",
    "photo",
    "utilities"
  ],
  "lang": "en-US",
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            ".heic",
            ".heif",
            ".tif",
            ".tiff",
            ".bmp",
            ".svg",
            ".ico",
            ".jfif",
            ".mp4",
            ".m4v",
            ".mov",
            ".webm"
          ]
        }
      ]
    }
  }
}
